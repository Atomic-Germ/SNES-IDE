        "darwin": {
          "commands": [
            "cd devkitsnes && make",
            "cd pvsneslib && make"
          ],
          "env": {
            "PVSNESLIB_HOME": "${TOOL_DIR}"
          }
        },
        "win32": {
          "commands": [
            "cd devkitsnes && make",
            "cd pvsneslib && make"
          ],
          "env": {
            "PVSNESLIB_HOME": "${TOOL_DIR}"
          }
        }
