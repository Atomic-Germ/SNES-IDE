{
  "version": "1.1.0",
  "description": "SNES-IDE Mini - Build-on-demand tool configuration",
  "schema_notes": {
    "dependency_format": "Dependencies can be arrays of package names (standard install) or objects with 'command' and 'args' keys for custom commands like 'builddep'. Example: {\"command\": \"builddep\", \"args\": [\"package-name\"]}",
    "repo_install": "Tools can have a 'repo_install' section for direct package manager installation as an alternative to building from source. When present, users get 'Install' and 'Build' buttons instead of 'Start'.",
    "package_name": "Use this field when the package name differs from the tool name. For example, 'ca65' is part of the 'cc65' package. This is the first candidate checked for dynamic repo install detection."
  },
  "system_requirements": {
    "common": ["git", "make", "cmake", "python3"],
    "linux": {
      "apt": ["build-essential", "cmake", "git", "libpng-dev", "zlib1g-dev"],
      "dnf": ["gcc", "gcc-c++", "make", "cmake", "git", "libpng-devel", "zlib-devel"]
    },
    "darwin": {
      "brew": ["cmake", "libpng", "zlib"]
    },
    "win32": {
      "msys2": ["mingw-w64-x86_64-cmake", "mingw-w64-x86_64-gcc", "make"]
    }
  },
  "tools": [
