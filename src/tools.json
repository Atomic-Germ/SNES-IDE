    {
      "name": "pvsneslib",
      "description": "Comprehensive C-based SNES development SDK. Includes 816-tcc compiler, linker, graphics/audio tools, and runtime libraries. Enables high-level C programming for SNES with built-in sprite, background, input, and sound handling. The primary SDK for SNES-IDE projects.",
      "category": "sdk",
      "priority": "required",
      "source": {
        "type": "git",
        "url": "https://github.com/alekmaul/pvsneslib.git",
        "branch": "master",
        "tag": "4.4.0"
      },
      "binary_path": "",
      "is_sdk": true,
      "build": {
        "linux": {
          "commands": [
            "cd devkitsnes && make",
            "cd pvsneslib && make"
          ],
          "env": {
            "PVSNESLIB_HOME": "${TOOL_DIR}"
          }
        },
        "darwin": {
          "commands": [
            "cd devkitsnes && make",
            "cd pvsneslib && make"
          ],
          "env": {
            "PVSNESLIB_HOME": "${TOOL_DIR}"
          }
        },
        "win32": {
          "commands": [
            "cd devkitsnes && make",
            "cd pvsneslib && make"
          ],
          "env": {
            "PVSNESLIB_HOME": "${TOOL_DIR}"
          }
        }
      },
      "dependencies": {
        "linux": {
          "apt": ["build-essential", "libpng-dev", "zlib1g-dev"],
          "dnf": ["gcc", "gcc-c++", "make", "libpng-devel", "zlib-devel"]
        },
        "darwin": {
          "brew": ["libpng", "zlib"]
        },
        "win32": {
          "msys2": ["mingw-w64-x86_64-gcc", "mingw-w64-x86_64-libpng", "mingw-w64-x86_64-zlib"]
        }
      },
      "patches": ["16k-pagesize"],
      "post_install": {
        "create_symlinks": [
          {"from": "devkitsnes/bin", "to": "bin"},
          {"from": "devkitsnes/tools", "to": "tools"}
        ]
      }
    },
