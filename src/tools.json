    {
      "name": "dotnet8",
      "description": ".NET 8 SDK required for DotnetSnes development. Enables writing SNES games in C# using the DotnetSnes transpiler, which converts .NET IL to 65816 assembly. Includes runtime, compiler, and package management. Installed via Microsoft's official script.",
      "category": "sdk",
      "priority": "optional",
      "source": {
        "type": "script",
        "install_script": {
          "linux": "curl -sSL https://dot.net/v1/dotnet-install.sh | bash /dev/stdin --channel 8.0 --install-dir ${TOOL_DIR}",
          "darwin": "curl -sSL https://dot.net/v1/dotnet-install.sh | bash /dev/stdin --channel 8.0 --install-dir ${TOOL_DIR}",
          "win32": "powershell -Command \"& {Invoke-WebRequest -Uri 'https://dot.net/v1/dotnet-install.ps1' -OutFile 'dotnet-install.ps1'; ./dotnet-install.ps1 -Channel 8.0 -InstallDir '${TOOL_DIR}'}\""
        }
      },
      "binary_path": "dotnet",
      "binary_name": {
        "linux": "dotnet",
        "darwin": "dotnet",
        "win32": "dotnet.exe"
      },
      "is_sdk": true,
      "dependencies": {
        "linux": {
          "apt": ["curl", "libicu-dev"],
          "dnf": ["curl", "libicu"]
        },
        "darwin": {
          "brew": []
        },
        "win32": {
          "msys2": []
        }
      },
      "patches": [],
      "verify_command": ["dotnet", "--version"]
    },
