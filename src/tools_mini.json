    {
      "name": "pvsneslib",
      "description": "Complete SNES development framework - builds from source",
      "category": "sdk",
      "priority": "required",
      "source": {
        "type": "git",
        "url": "https://github.com/alekmaul/pvsneslib.git",
        "branch": "master",
        "tag": "4.4.0"
      },
      "binary_path": "",
      "is_sdk": true,
      "build": {
        "linux": {
          "commands": [
            "cd devkitsnes && make",
            "cd pvsneslib && make"
          ],
          "env": {
            "PVSNESLIB_HOME": "${TOOL_DIR}"
          }
        },
        "darwin": {
          "commands": [
            "cd devkitsnes && make",
            "cd pvsneslib && make"
          ],
          "env": {
            "PVSNESLIB_HOME": "${TOOL_DIR}"
          }
        },
