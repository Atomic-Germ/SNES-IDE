  "patch_sets": {
    "16k-pagesize": {
      "description": "Patches for systems with 16K page size (e.g., Asahi Linux on Apple Silicon)",
      "detection": {
        "command": "getconf PAGESIZE",
        "condition": "output > 4096"
      },
      "files": []
    }
  },
  "platform_detection": {
    "asahi": {
      "check_file": "/etc/os-release",
      "contains": "asahi"
    },
    "pagesize_16k": {
      "command": "getconf PAGESIZE",
      "equals": "16384"
    }
  }
}
