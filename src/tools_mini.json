          "darwin": "curl -sSL https://dot.net/v1/dotnet-install.sh | bash /dev/stdin --channel 8.0 --install-dir ${TOOL_DIR}",
          "win32": "powershell -Command \"& {Invoke-WebRequest -Uri 'https://dot.net/v1/dotnet-install.ps1' -OutFile 'dotnet-install.ps1'; ./dotnet-install.ps1 -Channel 8.0 -InstallDir '${TOOL_DIR}'}\""
        }
      },
